<?include ("../../../conexiones/config_pro.php");

include("../../../conexiones/config_pro.php");
$sql2 = "SELECT * FROM `ventas_encabezado`  WHERE  `tipo_fact` = 'B'";
$result2 = $db->Execute($sql2);

if (!$result2) die("fallo".$db->ErrorMsg());

 while (!$result2->EOF) {

$nro_factura=strtoupper($result2->fields["nro_factura"]);
echo "---".$neto=strtoupper($result2->fields["neto"]);

$neto_gravado = round(($neto / 1.21),2);
//
$iva = $neto - $neto_gravado;




ECHO $sql = "UPDATE `ventas_encabezado` SET  `neto_gravado` = '$neto_gravado' , `iva` = '$iva' WHERE `tipo_fact` = 'B' AND `nro_factura` = '$nro_factura'";
mysql_query($sql);
echo "<br>";
	 $result2->MoveNext();
		}





