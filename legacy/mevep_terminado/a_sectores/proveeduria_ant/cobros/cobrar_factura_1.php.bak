<script language="javascript">
function on_load()
{
document.getElementById("operador").focus();
}

function verif_caracter(obj,evt)
{

	evt = (evt) ? evt : event;
	var charCode = (evt.charCode) ? evt.charCode : ((evt.which) ? evt.which : evt.keyCode);
	if (charCode == 13) 

	{
		switch(obj.id)
		{
				case "operador":
				document.getElementById("tipo_cuenta").focus();
				break;
				case "tipo_cuenta":
				document.getElementById("busca").focus();
				break;
				case "busca":
				document.getElementById("nro_recibo").focus();
				break;

				case "nro_recibo":
				document.getElementById("dia").focus();
				break;

			
				case "dia":
				document.getElementById("mes").focus();
				break;

				case "mes":
				document.getElementById("anio").focus();
				break;

								case "anio":
				document.getElementById("cant_fact").focus();
				break;

				case "cant_fact":
				document.getElementById("guardar").focus();
				break;
				
				
		}
		return false;
	}
	return true;
}


function abrirVentan() {
	var cod_detalle = <?echo $cod_detalle;?> 
    open("seleccionar_busqueda.php","SALDOS DEUDORES", "width=450,height=450,toolbar=no,directories=no,menubar=no,status=no, scrollbars=01, top = 35");
}

</script>


