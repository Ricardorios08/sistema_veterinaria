//$result1 = $db_pro->Execute($sql);

if ($forma_pago == 'CTA/CTE'){
echo $sql = "UPDATE `composicion_saldos` SET `comprobante` = $nro_factura_nuevo WHERE `nro_factura` = $nro_factura and tipo_fact = '$tipo_fact'";
