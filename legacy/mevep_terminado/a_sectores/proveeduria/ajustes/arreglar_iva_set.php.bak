$sql2 = "SELECT * FROM `ventas_encabezado` where fecha between '2008-09-01' AND '2008-10-16' and ((cod_operacion = '1') or (cod_operacion = '3')) and tipo_fact = 'B'" ;
$result2 = $db->Execute($sql2);

