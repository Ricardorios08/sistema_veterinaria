 while (!$result2->EOF) {

echo $nro_factura=strtoupper($result2->fields["nro_factura"]);
$neto=strtoupper($result2->fields["neto"]);

echo " - ";
echo $neto_gravado = round(($neto / 1.21),2);
echo " - ";
echo $iva= $neto - $neto_gravado;


